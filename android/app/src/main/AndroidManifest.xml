<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A fully managed DPC must inventory installed packages to enforce its allowlist. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required when JobScheduler enforces network constraints for update checks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Granted through the system Usage Access app-op; this is not a
         privileged-only permission on managed devices. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:name=".GuardApplication"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".guard.GuardQuizActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".guard.GuardNoticeActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".guard.GuardUsageReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <!-- A consented call surface is visible and non-exported. The child
             must explicitly accept before the server releases a LiveKit token. -->
        <activity
            android:name=".guard.GuardCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".guard.GuardLauncherActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=".guardhome"
            android:theme="@style/AppTheme">
            <intent-filter android:priority="900">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".guard.GuardScreenshotActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".guard.GuardScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name='.guard.GuardActivity'
            android:exported='false' />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AllowedAppsActivity"
            android:exported="false" />

        <!--
            System policy controls. Not exported: it is opened from the console
            only, and it refuses to draw at all without a live administrator
            session, so nothing outside this package can reach the switches that
            withdraw the device recovery path.
        -->
        <activity
            android:name=".ui.SystemPolicyActivity"
            android:exported="false" />

        <!--
            Management identity console. Not exported for the same reason: it
            writes the signing-certificate pins that decide which package is
            allowed to keep management privilege, and a pin written by anything
            other than an authenticated administrator would be a privilege grant.
        -->
        <activity
            android:name=".ui.ManagementIdentityActivity"
            android:exported="false" />

        <!--
            Timed maintenance mode. Not exported: this screen deliberately makes a
            managed device weaker for a bounded period, including the break-glass
            debugging option, so it is reachable only from an authenticated
            administrator session inside this package.
        -->
        <activity
            android:name=".ui.MaintenanceActivity"
            android:exported="false" />

        <!--
            Local device health report. Not exported: the report names policy
            state, kiosk state and management identity, and the export is an
            explicit administrator action rather than something another
            application may ask for.
        -->
        <activity
            android:name=".ui.DeviceHealthActivity"
            android:exported="false" />

        <!--
            Emergency exception and Device Owner release. Not exported: the
            screen changes the device's management state and re-authenticates
            the administrator before every sensitive action.
        -->
        <activity
            android:name=".ui.RecoveryActivity"
            android:exported="false" />

        <!--
            Kiosk HOME surface. Disabled in the manifest so an upgrade never turns
            a managed device into a kiosk; KioskController enables the component
            and installs the HOME preference only while kiosk is active, and
            disables it again on exit. It must be exported because the system
            starts HOME, but it grants nothing: it renders stored kiosk state and
            the only way out is an authenticated administrator session.
        -->
        <activity
            android:name=".kiosk.KioskHostActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity=".kiosk"
            android:theme="@style/AppTheme">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BlockedBrowserActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".admin.LockdownAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!--
            Locale configuration only. On API 33+ AppCompat forwards the display
            language to the platform LocaleManager; below that it needs this
            marker service to persist the choice across process restarts. The
            component is never started, which is why it stays disabled.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            A DeviceAdminService is the Android-supported way for a device owner
            targeting API 26+ to keep a runtime package receiver available. The
            BIND_DEVICE_ADMIN permission prevents other apps from binding it.
        -->
        <service
            android:name=".admin.LockdownDeviceAdminService"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".updates.UpdateCheckJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Closes a maintenance window that has run out, whether or not the
            console is open. Exported with BIND_JOB_SERVICE because that is how
            JobScheduler binds; the permission means only the platform can.
        -->
        <service
            android:name=".maintenance.MaintenanceGuardJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Ends a timed emergency exception even when the UI is closed. -->
        <receiver
            android:name=".recovery.EmergencyAccessReceiver"
            android:exported="false" />

        <receiver
            android:name=".updates.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".receivers.PolicyRefreshReceiver"
            android:directBootAware="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receivers.PolicyUpdateAuditReceiver"
            android:enabled="@bool/policy_update_receiver_enabled"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.admin.action.DEVICE_POLICY_SET_RESULT" />
                <action android:name="android.app.admin.action.DEVICE_POLICY_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name='.guard.GuardEnforcementJobService'
            android:exported='true'
            android:permission='android.permission.BIND_JOB_SERVICE' />

        <service
            android:name='.guard.GuardSyncJobService'
            android:exported='true'
            android:permission='android.permission.BIND_JOB_SERVICE' />

        <receiver
            android:name=".guard.GuardCallActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".guard.GuardNoticeActionReceiver"
            android:exported="false" />

        <service
            android:name=".guard.GuardMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Parental screen-time policy enforcement on a device-owner managed device, with a visible persistent notification." />
        </service>
    </application>

</manifest>
