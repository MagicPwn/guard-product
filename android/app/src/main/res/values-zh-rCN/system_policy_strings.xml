    <string name="system_policy_error_auth">管理员会话已过期。请重新输入 PIN 以更改系统策略。</string>
    <string name="system_policy_confirm_enable_title">开启此控制？</string>
    <string name="system_policy_confirm_disable_title">关闭此控制？</string>
    <string name="system_policy_confirm_disable_body">下次应用策略时会解除限制，当前持有设备的人将可以使用该能力。</string>
    <string name="system_policy_confirm_apply">确认</string>
    <string name="system_policy_control_developer_options_and_adb_title">开发者选项与 USB 调试</string>
    <string name="system_policy_control_developer_options_and_adb_consequence">关闭开发者选项和 ADB。USB 调试是管理应用无法访问时恢复设备的官方途径，因此开启它会移除当前恢复路径。在已签名更新成功安装到此硬件前，请勿启用。</string>
    <string name="system_policy_control_usb_file_transfer_title">USB 文件传输</string>
    <string name="system_policy_control_usb_file_transfer_consequence">设备仍可通过 USB 充电，但不能作为存储挂载，因此无法用线缆复制文件。</string>
    <string name="system_policy_control_unknown_source_installs_title">从未知来源安装</string>
    <string name="system_policy_control_unknown_source_installs_consequence">无法再从文件或经批准安装程序之外的任何来源安装应用。Android 10 及更高版本中，此限制也会覆盖设备上的其他配置文件。</string>
    <string name="system_policy_control_app_stores_and_installers_title">所有软件包安装，包括商店</string>
    <string name="system_policy_control_app_stores_and_installers_consequence">阻止设备上的所有安装程序。Android 也会将此应用于管理应用，因此开启后设备守护无法安装自己的签名更新。在能够通过其他方式提供更新前，请保持关闭。</string>
    <string name="system_policy_control_account_modification_title">添加和更改账户</string>
    <string name="system_policy_control_account_modification_consequence">无法在设置中添加、删除或重新配置账户，包括已安装应用登录所需的账户。</string>
    <string name="system_policy_control_vpn_configuration_title">VPN 配置</string>
    <string name="system_policy_control_vpn_configuration_consequence">使用设备的人无法创建或编辑 VPN。已由管理端配置的 VPN 仍可工作。</string>
    <string name="system_policy_control_network_reset_title">重置网络设置</string>
    <string name="system_policy_control_network_reset_consequence">设置中一次清除 Wi-Fi、移动数据和蓝牙的操作将不可用，避免意外断开管理连接。</string>
    <string name="system_policy_control_tethering_title">网络共享与便携热点</string>
    <string name="system_policy_control_tethering_consequence">设备无法通过 Wi-Fi、USB 或蓝牙与其他设备共享连接。</string>
    <string name="system_policy_control_wifi_configuration_title">Wi-Fi 网络配置</string>
    <string name="system_policy_control_wifi_configuration_consequence">使用设备的人无法添加或更改 Wi-Fi 网络。不同厂商实际拒绝的范围不同，因此此控制单独报告，不会单独将保护标记为故障。如果设备同时失去管理网络，只能现场恢复。</string>
    <string name="system_policy_control_private_dns_title">私人 DNS</string>
    <string name="system_policy_control_private_dns_consequence">无法更改私人 DNS 模式，因此域名解析不能指向未过滤的解析器。需要 Android 10 或更高版本。</string>
    <string name="system_policy_control_date_and_time_title">日期、时间和时区</string>
    <string name="system_policy_control_date_and_time_consequence">无法手动设置时钟。证书检查和计划任务依赖正确时间。需要 Android 9 或更高版本。</string>
    <string name="system_policy_control_safe_boot_title">安全启动</string>
    <string name="system_policy_control_safe_boot_consequence">设备无法重启进入安全启动，否则会以管理策略未生效的状态启动。</string>
    <string name="system_policy_control_factory_reset_title">从设置恢复出厂设置</string>
    <string name="system_policy_control_factory_reset_consequence">设置中的重置操作将不可用。从硬件恢复菜单启动的重置不在任何管理应用可阻止的范围内。</string>
    <string name="system_policy_control_user_and_profile_creation_title">其他用户和配置文件</string>
    <string name="system_policy_control_user_and_profile_creation_consequence">无法创建新用户或工作配置文件，Android 9 及更高版本中也会阻止切换用户。这可防止同一设备出现第二个未受管理的会话。</string>
    <string name="system_policy_control_app_uninstall_title">卸载应用</string>
    <string name="system_policy_control_app_uninstall_consequence">使用设备的人无法移除应用。</string>
    <string name="system_policy_control_app_control_settings_title">设置中的应用控制</string>
    <string name="system_policy_control_app_control_settings_consequence">设置中的强制停止、清除数据和清除缓存将不可用，因此受管应用无法通过清除状态被解除。</string>
    <string name="system_policy_section_play_compatibility">Google Play 兼容性</string>
    <string name="system_policy_play_compat_row">允许需要 Google Play 商店的应用</string>
    <string name="system_policy_play_compat_body">某些通过 Google Play 分发的应用即使 Google Play 服务正常，也会在 Play 商店包不可用时拒绝启动。开启此项会让该包保持可用。Android 无法只隐藏商店图标，因此在普通启动器中商店可能仍可见并可打开。真正被阻止的是安装：开启期间会强制执行并验证所有软件包安装和未知来源安装。Kiosk 设备中用户无法接触商店。Google Play 服务和 WebView 提供程序另行保护，不受此选择影响。其他应用商店仍会隐藏。</string>
    <string name="system_policy_play_compat_state_strict">关闭 — 应用商店保持隐藏</string>
    <string name="system_policy_play_compat_state_active">开启 — 商店包可用，设备已确认安装被阻止</string>
    <string name="system_policy_play_compat_state_maintenance">开启 — 维护窗口开放了应用商店安装，窗口关闭时恢复</string>
    <string name="system_policy_play_compat_state_withheld">开启，但维护窗口开放了未知来源安装，窗口关闭前商店保持隐藏</string>
    <string name="system_policy_play_compat_state_unverified">开启，但设备尚未确认安装锁定，因此商店保持隐藏</string>
    <string name="system_policy_play_compat_locked_control">由 Google Play 兼容性保持开启</string>
    <string name="system_policy_play_compat_confirm_enable_title">保持 Google Play 商店可用？</string>
    <string name="system_policy_play_compat_confirm_enable_body">Google Play 商店包将继续提供给需要它的应用。作为交换，所有软件包安装和未知来源安装都会开启、保持开启并从设备读回验证。安装被阻止时设备守护无法安装自己的签名更新，因此继续前请规划其他更新方式。普通启动器中商店可能仍可见并可打开；被阻止的是安装。如果设备未确认安装锁定，商店会重新隐藏，保护将报告为未验证。</string>
    <string name="system_policy_play_compat_confirm_disable_title">再次隐藏应用商店？</string>
    <string name="system_policy_play_compat_confirm_disable_body">下次应用策略时会再次隐藏 Google Play 商店包，依赖它的应用可能停止启动。此模式保持开启的安装控制会恢复为你自己保存的选择。</string>
