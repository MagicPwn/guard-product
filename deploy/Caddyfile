{$GUARD_WEB_DOMAIN} {
    encode zstd gzip
    handle /api/* {
        reverse_proxy server:8080
    }
    handle /healthz {
        reverse_proxy server:8080
    }
    handle {
        reverse_proxy web:80
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

{$GUARD_LIVEKIT_DOMAIN} {
    reverse_proxy livekit:7880
}
