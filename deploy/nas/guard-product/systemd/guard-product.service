[Unit]
Description=Guard API and PostgreSQL (Docker Compose)
Requires=docker.service
RequiresMountsFor=/volume2/workspace/service/guard-product
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/volume2/workspace/service/guard-product
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
